# Copy to .env and fill in your RPC endpoints (Alchemy/Infura recommended)
# Fork tests skip automatically if these are missing.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Tip: use archive RPC if you pin a historical block in PoC tests
